---
import { t, type Locale } from '../i18n/ui';
import type { ProjectPayload } from '../lib/events';

interface Props {
	lang: Locale;
	items: { image: string; title: string; project: ProjectPayload }[];
}
const { lang, items } = Astro.props;
---

<section class="max-w-[1400px] mx-auto px-6 md:px-14 py-10 md:py-16" id="screens">
	<div class="mb-8">
		<h2 class="text-3xl md:text-5xl font-extrabold uppercase tracking-[-0.04em]">{t(lang, 'screens.title')}</h2>
	</div>
	<div class="w-full relative overflow-hidden h-[460px] md:h-[680px]">
		<div
			data-wheel
			data-items={JSON.stringify(items)}
			data-label={t(lang, 'screens.label')}
			data-action={t(lang, 'screens.action')}
			data-hint={t(lang, 'screens.hint')}
			class="w-full h-full relative"
		>
		</div>
	</div>
</section>

<script>
	import { initWorksWheel } from '../engines/works-wheel.js';
	import { openProject } from '../lib/events';
	const el = document.querySelector<HTMLElement>('[data-wheel]');
	if (el) {
		const { label, action, hint } = el.dataset;
		initWorksWheel(el, {
			items: JSON.parse(el.dataset.items || '[]'),
			label,
			action,
			hint,
			onSelect: (_: number, item: { project: Parameters<typeof openProject>[0] }) => openProject(item.project),
		});
	}
</script>
