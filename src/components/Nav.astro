---
import { locales, localeNames, t, type Locale } from '../i18n/ui';
import { site } from '../data/site';

interface Props {
	lang: Locale;
}
const { lang } = Astro.props;
const links = [
	['home', t(lang, 'nav.home')],
	['about', t(lang, 'nav.about')],
	['journey', t(lang, 'nav.journey')],
	['projects', t(lang, 'nav.projects')],
	['screens', t(lang, 'nav.screens')],
	['services', t(lang, 'nav.services')],
] as const;
const github =
	'<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>';
---

<header class="relative z-40 w-full max-w-[1400px] mx-auto pt-6 pb-4 px-6 md:px-14 flex items-center justify-between">
	<a class="group flex items-center gap-2 font-extrabold text-lg md:text-xl tracking-tight text-white" href="#home" aria-label={site.handle}>
		<img src="/logo.svg" alt="" width="36" height="30" class="w-7 md:w-9 h-auto transition-transform duration-500 ease-[var(--ease-expo)] group-hover:-translate-y-0.5 group-hover:rotate-[-8deg]" />
		<span class="uppercase">{site.handle}</span>
	</a>

	<nav class="hidden lg:flex items-center gap-1 p-1 bg-white/[0.04] border border-white/10 rounded-full text-xs font-semibold tracking-wider text-white/60 uppercase" data-nav>
		{
			links.map(([id, label]) => (
				<a
					href={`#${id}`}
					data-nav-link={id}
					class="px-4 py-2 rounded-full border border-transparent hover:text-white hover:border-white/15 transition whitespace-nowrap aria-[current=true]:text-white aria-[current=true]:border-white/25 aria-[current=true]:bg-white/[0.06]"
				>
					{label}
				</a>
			))
		}
	</nav>

	<div class="flex items-center gap-0.5 md:gap-1 p-1 md:p-1.5 bg-white/[0.04] border border-white/10 rounded-full">
		{
			locales.map((l) => (
				<a
					href={`/${l}/`}
					hreflang={l}
					aria-current={l === lang ? 'true' : undefined}
					class="h-7 md:h-8 px-2 md:px-2.5 rounded-full grid place-items-center text-[11px] font-mono font-semibold text-white/45 hover:text-white transition aria-[current=true]:text-white aria-[current=true]:bg-white/10"
				>
					{localeNames[l]}
				</a>
			))
		}
		<a class="hidden md:grid w-8 h-8 rounded-full place-items-center text-white/70 hover:text-white hover:bg-white/10 transition" href={site.github} target="_blank" rel="noopener" title="GitHub">
			<Fragment set:html={github} />
		</a>
		<button type="button" data-drawer-open aria-label={t(lang, 'nav.menu')} class="lg:hidden w-7 h-7 md:w-8 md:h-8 rounded-full grid place-items-center text-white/80 hover:bg-white/10 transition">
			<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
		</button>
	</div>
</header>

<div data-drawer class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 flex justify-end">
	<div data-drawer-panel class="w-4/5 max-w-sm h-full bg-panel border-l border-white/10 p-8 flex flex-col justify-between translate-x-full transition-transform duration-300">
		<div>
			<div class="flex items-center justify-between pb-6 border-b border-white/10">
				<span class="font-extrabold text-lg tracking-tight uppercase">{site.handle}<span class="brand-gradient">•</span></span>
				<button type="button" data-drawer-close aria-label={t(lang, 'nav.close')} class="w-8 h-8 rounded-full border border-white/20 grid place-items-center hover:border-white">✕</button>
			</div>
			<nav class="flex flex-col gap-4 mt-8 text-base font-bold tracking-wider uppercase">
				{links.map(([id, label]) => <a href={`#${id}`} data-drawer-close class="py-2 border-b border-white/5 hover:text-lavender">{label}</a>)}
				<a href="#contact" data-drawer-close class="py-2 brand-gradient">{t(lang, 'nav.contact')}</a>
			</nav>
		</div>
		<div class="pt-6 border-t border-white/10">
			<p class="text-xs uppercase tracking-widest text-white/40 mb-2">{t(lang, 'name')}</p>
			<p class="text-xs text-white/60">Full-stack developer</p>
		</div>
	</div>
</div>

<script>
	const drawer = document.querySelector<HTMLElement>('[data-drawer]');
	const panel = document.querySelector<HTMLElement>('[data-drawer-panel]');
	const toggle = (open: boolean) => {
		drawer?.classList.toggle('opacity-0', !open);
		drawer?.classList.toggle('pointer-events-none', !open);
		panel?.classList.toggle('translate-x-full', !open);
	};
	document.querySelector('[data-drawer-open]')?.addEventListener('click', () => toggle(true));
	document.querySelectorAll('[data-drawer-close]').forEach((el) => el.addEventListener('click', () => toggle(false)));
	drawer?.addEventListener('click', (e) => e.target === drawer && toggle(false));

	const links = new Map<string, HTMLElement>();
	document.querySelectorAll<HTMLElement>('[data-nav-link]').forEach((a) => links.set(a.dataset.navLink!, a));
	const io = new IntersectionObserver(
		(entries) => {
			for (const e of entries)
				if (e.isIntersecting) links.forEach((a, id) => a.setAttribute('aria-current', String(id === e.target.id)));
		},
		{ rootMargin: '-20% 0px -60% 0px' },
	);
	links.forEach((_, id) => {
		const s = document.getElementById(id);
		if (s) io.observe(s);
	});
</script>
