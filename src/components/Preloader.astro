---
import RocketLogo from './RocketLogo.astro';
---

<div data-preloader class="fixed inset-0 z-[100] grid place-items-center bg-void" aria-hidden="true">
	<div class="pl-stage flex flex-col items-center gap-7 px-6">
		<div class="relative grid place-items-center w-44 h-44">
			<div class="pl-glow absolute w-28 h-28 rounded-full bg-violet-500/25 blur-2xl"></div>
			<div class="pl-orbit absolute inset-0 rounded-full border border-lavender/15 border-t-violet-300/80"></div>
			<div class="pl-orbit2 absolute inset-7 rounded-full border border-indigo/20"></div>
			<div class="pl-rocket w-[84px]"><RocketLogo id="pl-rk" class="w-full h-auto" /></div>
		</div>
		<div class="pl-word font-black text-3xl md:text-4xl tracking-tight uppercase text-white">Noera<span class="brand-gradient">.</span></div>
		<div class="pl-track w-48 h-px rounded-full bg-white/10 overflow-hidden">
			<div class="pl-bar h-full w-full origin-left scale-x-0 bg-gradient-to-r from-indigo via-lavender to-white"></div>
		</div>
		<div class="pl-count font-mono text-[11px] tracking-[0.35em] text-white/50 uppercase">T-minus <span data-count>3</span></div>
	</div>
</div>

<script is:inline>
	// Skip on repeat visits within the session and for reduced motion.
	(function () {
		var el = document.querySelector('[data-preloader]');
		var root = document.documentElement;
		if (sessionStorage.getItem('noera-intro') || matchMedia('(prefers-reduced-motion: reduce)').matches) {
			el.remove();
			return;
		}
		sessionStorage.setItem('noera-intro', '1');
		root.style.setProperty('--intro', '1500ms');
		var n = el.querySelector('[data-count]'), i = 3;
		var tick = setInterval(function () { i -= 1; if (i > 0) n.textContent = i; else { clearInterval(tick); n.textContent = '0'; } }, 300);
		setTimeout(function () { el.setAttribute('data-launch', ''); }, 1050);
		setTimeout(function () { el.remove(); }, 2150);
	})();
</script>

<style>
	[data-preloader] {
		transition:
			transform 0.7s var(--ease-expo) 0.35s,
			visibility 0s linear 1.1s;
	}
	[data-preloader][data-launch] {
		transform: translateY(-100%);
		visibility: hidden;
	}
	.pl-stage {
		animation: pl-in 0.8s var(--ease-expo) both;
	}
	.pl-glow {
		animation: pl-glow 1.4s ease-in-out infinite;
	}
	.pl-orbit {
		animation: pl-spin 1.15s linear infinite;
	}
	.pl-orbit2 {
		animation: pl-in 1s var(--ease-expo) 0.1s both;
	}
	.pl-rocket {
		animation: pl-shake 0.55s ease-in-out 0.9s infinite;
		transition:
			scale 0.45s cubic-bezier(0.55, 0, 0.85, 0.36),
			opacity 0.4s ease 0.08s;
	}
	.pl-word {
		animation: pl-in 0.7s var(--ease-expo) 0.25s both;
	}
	.pl-bar {
		animation: pl-fill 1s linear 0.1s both;
	}
	.pl-count {
		animation: pl-in 0.7s var(--ease-expo) 0.35s both;
	}
	[data-launch] .pl-rocket {
		scale: 2.4;
		opacity: 0;
	}
	[data-launch] .pl-orbit,
	[data-launch] .pl-orbit2,
	[data-launch] .pl-glow,
	[data-launch] .pl-word,
	[data-launch] .pl-track,
	[data-launch] .pl-count {
		opacity: 0;
		transition: opacity 0.25s;
	}
	@keyframes pl-in {
		from {
			opacity: 0;
			transform: translateY(22px);
		}
	}
	@keyframes pl-spin {
		to {
			transform: rotate(360deg);
		}
	}
	@keyframes pl-glow {
		0%,
		100% {
			opacity: 0.7;
		}
		50% {
			opacity: 1;
		}
	}
	@keyframes pl-shake {
		0%,
		100% {
			transform: translateY(0);
		}
		25% {
			transform: translateY(-1.5px);
		}
		75% {
			transform: translateY(1.5px);
		}
	}
	@keyframes pl-fill {
		to {
			transform: scaleX(1);
		}
	}
</style>
