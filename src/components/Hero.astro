---
import RocketLogo from './RocketLogo.astro';
import { t, type Locale } from '../i18n/ui';

interface Props {
	lang: Locale;
}
const { lang } = Astro.props;
const disciplines = [t(lang, 'hero.d1'), t(lang, 'hero.d2'), t(lang, 'hero.d3')];
---

<main class="relative max-w-[1400px] mx-auto px-6 md:px-14 pt-6 md:pt-12 pb-20 overflow-x-clip" id="home">
	<div class="absolute inset-x-0 top-[18%] h-[70%] pointer-events-none -z-0 bg-[radial-gradient(40%_50%_at_50%_55%,rgba(108,108,247,0.22),transparent_70%)]"></div>

	<div class="text-center w-full mb-6 md:mb-10 relative z-0 select-none">
		<h1 class="hero-title text-[13vw] md:text-[7rem] lg:text-[8.6rem] font-extrabold uppercase leading-[0.9] tracking-[-0.045em]">
			<span class="block"><span class="hero-line inline-block text-white">{t(lang, 'hero.title.a')}</span></span>
			<span class="block"><span class="hero-line inline-block cosmic-title" style="--d:120ms">{t(lang, 'hero.title.b')}</span></span>
		</h1>
	</div>

	<div class="relative grid grid-cols-1 md:grid-cols-12 items-center mt-2 md:-mt-6">
		<div class="md:col-span-3 flex flex-row md:flex-col items-center md:items-start justify-between md:justify-start pl-2 md:pl-6 order-2 md:order-1 pt-4 md:pt-0 hero-side">
			<span class="text-xs font-bold tracking-wider uppercase text-white/80 md:mb-6">{t(lang, 'hero.est')}</span>
			<a class="circle-btn w-14 h-14 md:w-16 md:h-16" href="#about" aria-label={t(lang, 'hero.scroll')} string="magnetic">
				<svg class="w-5 h-5 text-white rotate-45" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"
					><path d="M14 5l7 7m0 0l-7 7m7-7H3" stroke-linecap="round" stroke-linejoin="round"></path></svg
				>
			</a>
		</div>

		<div class="md:col-span-6 flex justify-center order-1 md:order-2 relative z-10 -mt-8 md:-mt-24">
			<div class="relative w-[300px] h-[290px] md:w-[440px] md:h-[420px]" string="parallax" string-factor="-0.35">
				<div class="hero-rocket-glow absolute left-[8%] bottom-[4%] w-[55%] h-[45%] rounded-full pointer-events-none"></div>
				<div class="hero-rocket absolute inset-0 grid place-items-center">
					<RocketLogo id="hero-rk" class="w-full" label="noera" />
				</div>
			</div>
		</div>

		<div class="md:col-span-3 flex flex-col items-start md:items-end order-3 pt-6 md:pt-0 pr-2 md:pr-6 space-y-5 md:space-y-10 hero-side">
			<p class="text-[11px] md:text-xs uppercase font-medium leading-relaxed tracking-wider text-white/70 max-w-[230px]">
				{t(lang, 'hero.pitch')}
			</p>
			<div class="flex flex-row flex-wrap gap-x-5 gap-y-2 md:flex-col md:gap-x-0 md:space-y-3 text-[11px] md:text-xs font-semibold tracking-widest uppercase text-white/60 md:items-end">
				{
					disciplines.map((d, i) => (
						<a href="#services" data-svc={i} class="group/disc hover:text-white md:hover:-translate-x-1 transition-all flex items-center gap-2">
							<span class="font-mono text-[9px] text-white/30 group-hover/disc:text-lavender transition-colors">0{i + 1}</span>
							{d}
						</a>
					))
				}
			</div>
		</div>
	</div>
</main>

<script>
	// The rocket leans gently toward the cursor — keeps it feeling alive.
	const rocket = document.querySelector<HTMLElement>('.hero-rocket');
	const hero = document.getElementById('home');
	if (rocket && hero && matchMedia('(pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
		let tx = 0,
			ty = 0,
			x = 0,
			y = 0;
		let running = false;
		const loop = () => {
			x += (tx - x) * 0.05;
			y += (ty - y) * 0.05;
			rocket.style.transform = `rotate(${y * 3.5}deg) translate(${x * 9}px, ${y * 7}px)`;
			if (running) requestAnimationFrame(loop);
		};
		hero.addEventListener('pointermove', (e) => {
			tx = (e.clientX / innerWidth - 0.5) * 2;
			ty = (e.clientY / innerHeight - 0.5) * 2;
		});
		hero.addEventListener('pointerleave', () => {
			tx = 0;
			ty = 0;
		});
		new IntersectionObserver(([en]) => {
			if (en.isIntersecting && !running) {
				running = true;
				requestAnimationFrame(loop);
			} else if (!en.isIntersecting) {
				running = false;
			}
		}).observe(hero);
	}
</script>

<style>
	.hero-line {
		animation: hero-line 1.2s var(--ease-expo) both;
		animation-delay: calc(var(--d, 0ms) + var(--intro, 0ms));
	}
	.hero-side {
		animation: hero-fade 1s var(--ease-expo) both;
		animation-delay: calc(500ms + var(--intro, 0ms));
	}
	.hero-rocket {
		animation:
			hero-arrive 1.6s var(--ease-expo) both,
			hero-drift 9s ease-in-out 1.7s infinite;
		animation-delay: calc(200ms + var(--intro, 0ms)), calc(1800ms + var(--intro, 0ms));
	}
	/* Exhaust glow sits where the flame points, so the rocket lights the scene */
	.hero-rocket-glow {
		background: radial-gradient(closest-side, rgba(255, 190, 90, 0.35), rgba(168, 85, 247, 0.22) 45%, transparent);
		filter: blur(20px);
		animation: hero-fade 2s ease both;
		animation-delay: calc(900ms + var(--intro, 0ms));
	}
	@keyframes hero-line {
		from {
			opacity: 0;
			transform: translateY(40%);
		}
	}
	@keyframes hero-fade {
		from {
			opacity: 0;
			transform: translateY(12px);
		}
	}
	@keyframes hero-arrive {
		from {
			opacity: 0;
			transform: translate3d(-18%, 26%, 0) scale(0.86);
		}
	}
	@keyframes hero-drift {
		50% {
			translate: 0 -2%;
			rotate: -1.2deg;
		}
	}
	
	@media (prefers-reduced-motion: reduce) {
		.hero-line,
		.hero-side,
		.hero-rocket,
		.hero-rocket-glow,
		.o-arm {
			animation: none;
		}
	}
</style>
